+});
+Deno.test("wrong hour: waits (outside_send_window), then sends at the next day's reminder hour inside 72 h", () => {
+  assertEquals(planEmails(plus(26, 30), [noted()], ALL).skipped, { outside_send_window: 1 }); // Tue 10:00 AM ET
