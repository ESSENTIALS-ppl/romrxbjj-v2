+// P1-17 day 3 email fallback (Base only). Layout follows lifecycle-emails buildEmail (live v3); words come from copy.ts only.
+// No tracking pixels, no click tracking, no em dashes. One-click unsubscribe (RFC 8058) with a signed "protocol" scope token:
+// the Plan day reminders toggle (email_reminders) this email depends on. Uses the live unsubscribe v13 scopes as they are.
+import { EMAIL_OPENER, FOOTER, type Rendered } from "./copy.ts";
+import { APP_PATH } from "./logic.ts";
+
+/** P1-08 Base sender, the same value as ROMRX_SENDER in b19b13dca82a3c2eb34a641aa5ca79e410090c00
+ *  (lifecycle-emails/source/email.ts). Defined here so this function does not depend on that deploy. A test pins the two equal
+ *  whenever lifecycle-emails exports it. HELD with P1-08: no send before Jim's sender yes is relayed. */
+export const ROMRX_SENDER = { from: "ROMRx <hello@romrx.io>", replyTo: "hello@romrx.io" } as const;
+export const BASE_BRAND = { key: "base", name: "ROMRx", appBase: "https://romrx.io/app" } as const;
+
+const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+
+export interface Built { from: string; replyTo: string; subject: string; html: string; text: string; headers: Record<string, string>; }
+export function buildCheckinEmail(r: Rendered, to: string, links: { offKind: string; offAll: string; oneClick: string }, postalLine: string): Built {
+  const open = `${BASE_BRAND.appBase}${APP_PATH}`;
+  const p = (s: string) => `    <p style="font-size:14px;color:#1a2e2e;line-height:1.7;margin:0 0 12px;">${esc(s)}</p>`;
+  const sentTo = FOOTER.sentTo(to);
+  const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"></head>
+<body style="margin:0;padding:0;background:#f8fcfc;font-family:Inter,system-ui,sans-serif;">
+<div style="max-width:600px;margin:0 auto;padding:32px 24px;">
+  <div style="margin-bottom:24px;"><span style="font-family:Georgia,serif;font-size:22px;font-weight:700;color:#1a2e2e;">${esc(BASE_BRAND.name)}</span></div>
+  <div style="background:#fff;border-radius:12px;border:1px solid #cde0e0;padding:32px;">
+${p(EMAIL_OPENER)}
+${p(r.line1)}
+    <a href="${esc(open)}" style="display:inline-block;background:#1a2e2e;color:#fff;text-decoration:none;padding:12px 24px;border-radius:10px;font-size:13px;font-weight:600;margin:8px 0 12px;">${esc(r.button)}</a>
+${p(r.line3)}
+    <p style="font-size:12px;color:#5a7070;margin-top:24px;line-height:1.6;">${esc(FOOTER.why)} <a href="${esc(links.offKind)}" style="color:#008080;">${esc(FOOTER.off)}</a></p>
+    <p style="font-size:12px;color:#5a7070;line-height:1.6;"><a href="${esc(links.offAll)}" style="color:#008080;">${esc(FOOTER.allOff)}</a></p>
+  </div>
+  <p style="font-size:11px;color:#5a7070;text-align:center;margin-top:20px;">${esc(postalLine)}<br /><a href="mailto:${esc(ROMRX_SENDER.replyTo)}" style="color:#008080;">${esc(ROMRX_SENDER.replyTo)}</a><br />${esc(sentTo)}</p>
+</div></body></html>`;
+  const text = [
+    EMAIL_OPENER, "", r.line1, "", `${r.button}: ${open}`, "", r.line3, "",
+    `${FOOTER.why} ${FOOTER.off}: ${links.offKind}`, `${FOOTER.allOff}: ${links.offAll}`, "", postalLine, ROMRX_SENDER.replyTo, sentTo,
+  ].join("\n");
+  return {
+    from: ROMRX_SENDER.from, replyTo: ROMRX_SENDER.replyTo, subject: r.subject, html, text,
+    headers: { "List-Unsubscribe": `<${links.oneClick}>`, "List-Unsubscribe-Post": "List-Unsubscribe=One-Click" },
+  };
+}
diff --git a/supabase/functions/rombot-checkin/source/handler.ts b/supabase/functions/rombot-checkin/source/handler.ts
new file mode 100644
index 0000000..cd5770a
--- /dev/null
+++ b/supabase/functions/rombot-checkin/source/handler.ts
@@ -0,0 +1,95 @@
+// rombot-checkin handler (P1-17 day 3 ROMBot check-in). BUILD ONLY, not deployed. All I/O is injected.
+// Switches (fail-safe: ON only when exactly "on"; none is set by this build):
+//  - ROMBOT_CHECKIN_SEND: the whole feature. Off = dry run (plan only, no note, no email, no claim).
+//  - LIFECYCLE_EMAILS_SEND: the email fallback also needs the lifecycle send switch (same switch as lifecycle-emails).
+// Audience = the lifecycle rules: LIFECYCLE_AUDIENCE exactly "all", else canary LIFECYCLE_CANARY_USER_IDS only.
+// LIFECYCLE_SUPPRESS_USER_IDS is treated as a pending deletion request (skip), as in lifecycle-emails.
+import { flagOn, maskEmail, noteContent, APP_PATH, plan, type Candidate, type Planned } from "./logic.ts";
+import { buildCheckinEmail, type Built } from "./email.ts";
+import { POSTAL_LINE } from "../_shared/email_footer.ts";
+import { signUnsubToken } from "../_shared/unsub_token.ts";
+
+export interface NoteInsert {
+  user_id: string;
+  /** ai_conversations row: sport "base", provider "rombot", no title (no new words in the chat list). */
+  conversation: { sport: "base"; provider: "rombot"; context_snapshot: Record<string, unknown> };
+  /** ai_messages row: role "assistant". */
+  message: { role: "assistant"; content: string; tokens_used: 0; latency_ms: 0 };
+}
+export interface Deps {
+  env: (k: string) => string | undefined;
+  cronOk: (req: Request) => Promise<boolean>;
+  now: () => Date;
+  load: (now: Date) => Promise<Candidate[]>;
+  claim: (userId: string, id: string) => Promise<boolean>;
+  release: (userId: string, id: string) => Promise<void>;
+  insertNote: (n: NoteInsert) => Promise<boolean>;
+  send: (to: string, b: Built) => Promise<boolean>;
+}
+
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+export function idList(v: string | null | undefined): Set<string> {
+  return new Set((v ?? "").split(",").map((s) => s.trim().toLowerCase()).filter((s) => UUID_RE.test(s)));
+}
+/** Same opt-out endpoints as lifecycle-emails live v3 (Base confirm page + unsubscribe one-click). */
+export const UNSUB_BASE = "https://cqzvqzwwevnflinxgnpp.supabase.co/functions/v1/unsubscribe";
+export const CONFIRM_PAGE_BASE = "https://romrx.io/app/unsubscribe";
+
+export function noteFor(x: Planned): NoteInsert {
+  return {
+    user_id: x.user_id,
+    conversation: {
+      sport: "base", provider: "rombot",
+      context_snapshot: { kind: "checkin_d3", branch: x.branch, assessment_id: x.assessment_id, button: { label: x.rendered.button, path: APP_PATH } },
+    },
+    message: { role: "assistant", content: noteContent(x.rendered), tokens_used: 0, latency_ms: 0 },
+  };
+}
+
+export async function handle(req: Request, d: Deps): Promise<Response> {
+  const json = (b: unknown, status = 200) => new Response(JSON.stringify(b), { status, headers: { "Content-Type": "application/json", "Cache-Control": "no-store" } });
+  if (!(await d.cronOk(req))) return new Response("forbidden", { status: 403 });
+  const url = new URL(req.url);
+  const dry = !flagOn(d.env("ROMBOT_CHECKIN_SEND")) || url.searchParams.get("dry_run") === "1";
+  const emailOn = !dry && flagOn(d.env("LIFECYCLE_EMAILS_SEND"));
+  const all = d.env("LIFECYCLE_AUDIENCE") === "all";
+  const canary = idList(d.env("LIFECYCLE_CANARY_USER_IDS"));
+  const suppress = idList(d.env("LIFECYCLE_SUPPRESS_USER_IDS"));
+  const now = d.now();
+  const loaded = (await d.load(now)).map((c) => suppress.has(c.user_id.toLowerCase()) ? { ...c, deletion_requested: true } : c);
+  const p = plan(now, loaded, { all, canary });
+  if (dry) {
+    return json({
+      success: true, dry_run: true, send_enabled: false, email_enabled: false, audience: all ? "all" : "canary", date: now.toISOString(),
+      due: p.due.map((x) => ({ branch: x.branch, note_id: x.note_id, email: x.email ? maskEmail(x.email) : null, email_skip: x.email_skip, hour_source: x.send.hourSource, tz_source: x.send.tzSource })),
+      skipped: p.skipped, email_skipped: p.emailSkipped,
+    });
+  }
+  if (!all && canary.size === 0) return json({ success: true, send_enabled: true, audience: "canary", note: "no canary ids set; nothing written or sent" });
+  const r = { notes: 0, already: 0, failed: 0, emails_sent: 0, emails_already: 0, emails_failed: 0, emails_held: 0, emails_skipped: 0 };
+  const secret = d.env("UNSUBSCRIBE_HMAC_SECRET");
+  for (const x of p.due) {
+    let mine = false;
+    try { mine = await d.claim(x.user_id, x.note_id); } catch { r.failed++; continue; }
+    if (!mine) { r.already++; continue; } // one check-in per assessment, ever
+    let ok = false;
+    try { ok = await d.insertNote(noteFor(x)); } catch { ok = false; }
+    if (!ok) { r.failed++; try { await d.release(x.user_id, x.note_id); } catch { /* next hourly run retries inside the window */ } continue; }
+    r.notes++;
+    if (x.email_skip || !x.email) { r.emails_skipped++; continue; } // in-app note kept, no email
+    if (!emailOn) { r.emails_held++; continue; }
+    const [tKind, tAll] = [await signUnsubToken(secret, x.user_id, "protocol"), await signUnsubToken(secret, x.user_id, "all")];
+    if (!tKind || !tAll) { r.emails_failed++; continue; } // fail closed: no email without opt-out links
+    const built = buildCheckinEmail(x.rendered, x.email, {
+      offKind: `${CONFIRM_PAGE_BASE}?t=${tKind}`, offAll: `${CONFIRM_PAGE_BASE}?t=${tAll}`, oneClick: `${UNSUB_BASE}?t=${tKind}&b=base`,
+    }, POSTAL_LINE);
+    try {
+      if (!(await d.claim(x.user_id, x.email_id))) { r.emails_already++; continue; }
+    } catch { r.emails_failed++; continue; }
+    let sent = false;
+    try { sent = await d.send(x.email, built); } catch { sent = false; }
+    if (sent) r.emails_sent++;
+    else { r.emails_failed++; try { await d.release(x.user_id, x.email_id); } catch { /* not retried: the note is already claimed */ } }
+  }
+  return json({ success: true, send_enabled: true, email_enabled: emailOn, audience: all ? "all" : "canary", date: now.toISOString(), results: r });
+}
diff --git a/supabase/functions/rombot-checkin/source/index.ts b/supabase/functions/rombot-checkin/source/index.ts
new file mode 100644
index 0000000..3bac8a5
--- /dev/null
+++ b/supabase/functions/rombot-checkin/source/index.ts
@@ -0,0 +1,112 @@
+// rombot-checkin (P1-17 day 3 ROMBot check-in). NEW function, BUILD ONLY, not deployed; verify_jwt false (cron-only).
+// Cron-only (x-cron-secret via public.verify_webhook_secret, fail closed), like lifecycle-emails. Dry run unless
+// ROMBOT_CHECKIN_SEND === "on"; the email fallback also needs LIFECYCLE_EMAILS_SEND === "on". Reads only the user's own rows
+// listed in spec section 3; never scores, degrees, bands, prices or other users' data.
+import "jsr:@supabase/functions-js/edge-runtime.d.ts";
+import { createClient } from "jsr:@supabase/supabase-js@2";
+import { handle } from "./handler.ts";
+import type { Candidate } from "./logic.ts";
+import { deletionRequested } from "./deletion.ts";
+
+const SUPABASE_URL = Deno.env.get("SUPABASE_URL")!;
+const KEY = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
+const RESEND_API_KEY = Deno.env.get("RESEND_API_KEY") ?? "";
+const sb = createClient(SUPABASE_URL, KEY);
+
+async function cronOk(req: Request): Promise<boolean> {
+  const got = (req.headers.get("x-cron-secret") ?? "").trim();
+  if (got.length < 32) return false;
+  try {
+    const r = await fetch(`${SUPABASE_URL}/rest/v1/rpc/verify_webhook_secret`, {
+      method: "POST",
+      headers: { apikey: KEY, Authorization: `Bearer ${KEY}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ p_name: "cron_webhook_secret", p_candidate: got }),
+    });
+    return r.ok && (await r.json()) === true;
+  } catch { return false; }
+}
+
+async function isTest(email: string | null): Promise<boolean> {
+  if (!email) return true;
+  try {
+    const { data, error } = await sb.rpc("is_test_account", { p_email: email });
+    return error ? true : data === true; // fail closed: unknown = treated as test, no message
+  } catch { return true; }
+}
+
+async function fullAssessments(userId: string): Promise<Candidate["full_assessments"]> {
+  // check_kind exists only after P1-06 031000; before that every row is a full assessment.
+  let q = await sb.from("assessments").select("id, assessed_at, red_flag_triggered, check_kind").eq("user_id", userId).order("assessed_at", { ascending: false }).limit(5);
+  if (q.error && q.error.code === "42703") q = await sb.from("assessments").select("id, assessed_at, red_flag_triggered").eq("user_id", userId).order("assessed_at", { ascending: false }).limit(5) as typeof q;
+  if (q.error) throw new Error("assessments load failed");
+  return ((q.data ?? []) as Record<string, unknown>[])
+    .filter((r) => r.check_kind !== "quick")
+    .map((r) => ({ id: String(r.id), assessed_at: String(r.assessed_at), red_flag_triggered: (r.red_flag_triggered as boolean | null) ?? null }));
+}
+
+async function load(now: Date): Promise<Candidate[]> {
+  // Day 3 in any zone falls inside 2 to 5 days after the assessment instant.
+  const from = new Date(now.getTime() - 5 * 86400000).toISOString();
+  const to = new Date(now.getTime() - 2 * 86400000).toISOString();
+  const { data: recent, error } = await sb.from("assessments").select("user_id").gte("assessed_at", from).lte("assessed_at", to).limit(5000);
+  if (error) throw new Error("recent assessments load failed");
+  const ids = [...new Set((recent ?? []).map((r) => String(r.user_id)))];
+  const out: Candidate[] = [];
+  for (const id of ids) {
+    const { data: u } = await sb.from("users").select("id, email, full_name, active_sport, base_status, marketing_opt_out").eq("id", id).maybeSingle();
+    if (!u) continue;
+    const full = await fullAssessments(id);
+    const newest = full[0];
+    const { data: pref } = await sb.from("notification_preferences").select("reminder_time, timezone, email_reminders, protocol_opt_in_at").eq("user_id", id).maybeSingle();
+    let ranked: string[] = [];
+    let sessions: string[] = [];
+    if (newest) {
+      const { data: pr } = await sb.from("protocols").select("joint_key, priority_rank").eq("assessment_id", newest.id).eq("user_id", id).order("priority_rank", { ascending: true });
+      ranked = (pr ?? []).map((r) => String(r.joint_key));
+      const { data: ss } = await sb.from("protocol_sessions").select("logged_at").eq("user_id", id).gte("logged_at", newest.assessed_at).limit(200);
+      sessions = (ss ?? []).map((r) => String(r.logged_at));
+    }
+    const { data: msg } = await sb.from("ai_messages").select("created_at").eq("user_id", id).eq("role", "user").order("created_at", { ascending: false }).limit(1).maybeSingle();
+    let nextCheckAt: string | null = null;
+    try {
+      const { data: sch, error: e } = await sb.from("user_mobility_schedule").select("next_check_at").eq("user_id", id).maybeSingle();
+      if (!e && sch) nextCheckAt = (sch as { next_check_at: string | null }).next_check_at ?? null;
+    } catch { nextCheckAt = null; } // table absent before P1-07 030000: Branch C is skipped (no_next_check)
+    out.push({
+      user_id: id, email: u.email ?? null, full_name: u.full_name ?? null, active_sport: u.active_sport ?? null,
+      base_status: u.base_status ?? null, marketing_opt_out: u.marketing_opt_out ?? null,
+      is_test: await isTest(u.email ?? null), deletion_requested: await deletionRequested(sb, id),
+      pref: pref ? { reminder_time: pref.reminder_time ?? null, timezone: pref.timezone ?? null, email_reminders: pref.email_reminders ?? null, protocol_opt_in_at: pref.protocol_opt_in_at ?? null } : null,
+      full_assessments: full, ranked_joint_keys: ranked, sessions_since: sessions,
+      last_user_message_at: (msg as { created_at?: string } | null)?.created_at ?? null, next_check_at: nextCheckAt,
+    });
+  }
+  return out;
+}
+
+Deno.serve((req) => handle(req, {
+  env: (k) => Deno.env.get(k),
+  cronOk, now: () => new Date(), load,
+  claim: async (user_id, email_id) => {
+    const { error } = await sb.from("email_sends").insert({ user_id, email_id });
+    if (!error) return true;
+    if (error.code === "23505") return false;
+    throw new Error("claim failed");
+  },
+  release: async (user_id, email_id) => { await sb.from("email_sends").delete().eq("user_id", user_id).eq("email_id", email_id); },
+  insertNote: async (n) => {
+    const { data: conv, error } = await sb.from("ai_conversations").insert({ user_id: n.user_id, ...n.conversation }).select("id").single();
+    if (error || !conv) return false;
+    const { error: mErr } = await sb.from("ai_messages").insert({ conversation_id: conv.id, user_id: n.user_id, ...n.message });
+    if (mErr) { await sb.from("ai_conversations").delete().eq("id", conv.id).eq("user_id", n.user_id); return false; } // no empty chat left behind
+    return true;
+  },
+  send: async (to, b) => {
+    if (!RESEND_API_KEY) return false;
+    const r = await fetch("https://api.resend.com/emails", {
+      method: "POST", headers: { Authorization: `Bearer ${RESEND_API_KEY}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ from: b.from, to: [to], subject: b.subject, html: b.html, text: b.text, reply_to: b.replyTo, headers: b.headers }),
+    });
+    return r.ok;
+  },
+}));
diff --git a/supabase/functions/rombot-checkin/source/logic.ts b/supabase/functions/rombot-checkin/source/logic.ts
new file mode 100644
index 0000000..3eb327b
--- /dev/null
+++ b/supabase/functions/rombot-checkin/source/logic.ts
@@ -0,0 +1,219 @@
+// P1-17 day 3 ROMBot check-in: pure rules (no I/O), so every rule is testable without a network.
+// Spec (behavior only, not words): /workspace/research/base-comp-20261115/reid/ROMBOT-DAY3-SPEC.md sections 2, 3, 6, 7.
+// Grant's rulings (Nov 16, 2026): send time = notification_preferences.reminder_time if set, else 9:00 AM; zone = the stored
+// timezone (the client saves the device zone there), else America/New_York. The email fallback goes out ONLY on a plan day,
+// at the reminder time, ONLY to P1-01 opt-ins (the same consent and opt-out settings lifecycle-emails honors); otherwise the
+// email is skipped and the in-app note is kept. Replies go to ai-chat, whose crisis route (live v96) is unchanged here.
+import { type Branch, type Fill, render, type Rendered } from "./copy.ts";
+
+/** P1-17 default send hour (Grant 9:28 AM ET Nov 16, overriding the spec's 7:00). Used ONLY when reminder_time is empty or unreadable. */
+export const DEFAULT_HOUR = 9;
+/** P1-17 fallback zone when no valid stored timezone exists. */
+export const DEFAULT_TZ = "America/New_York";
+/** Eligible from the send hour until this many hours later, so one failed hourly run is retried (same as lifecycle-emails). */
+export const SEND_WINDOW_HOURS = 3;
+/** The check-in goes on the user's local calendar day = assessment local date + 3. */
+export const CHECKIN_DAY = 3;
+/** Plan days. Mirrors lifecycle-emails PROTOCOL_DAYS (every weekday has a protocol in the apps; MyProtocol ROTATION covers 0 to 6).
+ *  A test pins this equal to lifecycle-emails, so the plan-day rule stays one rule. */
+export const PLAN_DAYS: readonly number[] = [0, 1, 2, 3, 4, 5, 6];
+/** MyProtocol.tsx ROTATION (romrx-io-web): weekday -> index into the user's ranked focus list. */
+export const ROTATION: Readonly<Record<number, number>> = { 1: 0, 2: 1, 3: 2, 4: 0, 5: 1, 6: 2, 0: 0 };
+/** Plain body part names for {today_area} (spec section 3: body part names only, no degrees, scores or bands).
+ *  Keyed by joint family (protocols.joint_key prefix). Unknown family = no message (fail closed). */
+export const AREA_BY_FAMILY: Readonly<Record<string, string>> = {
+  hip: "hips", shoulder: "shoulders", cervical: "neck", ankle: "ankles",
+};
+/** Stop rules (spec section 7). */
+export const BRANCH_C_RECENT_SESSION_HOURS = 12;
+export const RECENT_ROMBOT_MESSAGE_HOURS = 24;
+
+export function flagOn(v: string | null | undefined): boolean { return v === "on"; }
+
+export function validTz(tz: string | null | undefined): tz is string {
+  if (!tz || typeof tz !== "string" || tz.length > 64) return false;
+  try { new Intl.DateTimeFormat("en-US", { timeZone: tz }); return true; } catch { return false; }
+}
+/** reminder_time text such as "07:00", "7:00", "08:30:00" or "8:30 AM". Returns null when empty or unreadable. */
+export function parseReminderHour(t: string | null | undefined): number | null {
+  if (t === null || t === undefined || typeof t !== "string" || t.trim() === "") return null;
+  const m = /^\s*(\d{1,2})(?::(\d{2}))?(?::\d{2})?\s*([AaPp][Mm])?\s*$/.exec(t);
+  if (!m) return null;
+  let h = parseInt(m[1], 10);
+  const ap = m[3]?.toLowerCase();
+  if (ap) { if (h < 1 || h > 12) return null; if (ap === "pm" && h < 12) h += 12; if (ap === "am" && h === 12) h = 0; }
+  if (h < 0 || h > 23) return null;
+  return h;
+}
+
+export interface SendTime { hour: number; tz: string; hourSource: "reminder_time" | "default_9"; tzSource: "stored" | "default_ny"; }
+/** Send-time fallback order (Grant): 1) reminder_time if set; 2) else 9:00. Zone: stored timezone if valid, else America/New_York. */
+export function sendTime(pref: { reminder_time?: string | null; timezone?: string | null } | null | undefined): SendTime {
+  const h = parseReminderHour(pref?.reminder_time ?? null);
+  const tzOk = validTz(pref?.timezone ?? null);
+  return {
+    hour: h ?? DEFAULT_HOUR, hourSource: h === null ? "default_9" : "reminder_time",
+    tz: tzOk ? pref!.timezone! : DEFAULT_TZ, tzSource: tzOk ? "stored" : "default_ny",
+  };
+}
+
+export function localParts(now: Date, tz: string): { date: string; hour: number; dow: number } {
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone: tz, year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", hourCycle: "h23", weekday: "short",
+  }).formatToParts(now);
+  const g = (t: string) => parts.find((p) => p.type === t)?.value ?? "";
+  return { date: `${g("year")}-${g("month")}-${g("day")}`, hour: parseInt(g("hour"), 10) % 24, dow: ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].indexOf(g("weekday")) };
+}
+export function inWindow(localHour: number, targetHour: number): boolean {
+  const d = (localHour - targetHour + 24) % 24;
+  return d >= 0 && d < SEND_WINDOW_HOURS;
+}
+export function ymdAdd(date: string, days: number): string {
+  const [y, m, d] = date.split("-").map((x) => parseInt(x, 10));
+  return new Date(Date.UTC(y, m - 1, d + days)).toISOString().slice(0, 10);
+}
+/** Stacy's date format for {next_check_date}: "Monday, Dec 28". */
+export function shortDate(iso: string | null | undefined, tz: string): string | null {
+  if (!iso) return null;
+  const t = Date.parse(iso);
+  if (!Number.isFinite(t)) return null;
+  const parts = new Intl.DateTimeFormat("en-US", { timeZone: tz, weekday: "long", month: "short", day: "numeric" }).formatToParts(new Date(t));
+  const g = (x: string) => parts.find((p) => p.type === x)?.value ?? "";
+  if (!g("weekday") || !g("month") || !g("day")) return null;
+  return `${g("weekday")}, ${g("month")} ${g("day")}`;
+}
+
+/** First name: first word of users.full_name, else no name (spec section 3). Only plain name characters are used, because
+ *  ROMBot.tsx renders message lines as HTML; anything else (an email, digits, markup) gives the no-name copy. */
+export function firstName(full: string | null | undefined): string | null {
+  const f = (full ?? "").trim().split(/\s+/)[0] ?? "";
+  return /^\p{L}[\p{L}'.-]{0,39}$/u.test(f) ? f : null;
+}
+
+export function branchFor(n: number): Branch { return n <= 0 ? "A" : n <= 2 ? "B" : "C"; }
+
+/** {today_area}: the user's ranked focus list (protocols for the assessment, priority_rank ascending), picked like MyProtocol's
+ *  TodayCard: ranked[min(ROTATION[dow], len - 1)]. Returns null when it cannot be named. */
+export function todayArea(rankedJointKeys: string[], dow: number): string | null {
+  if (!rankedJointKeys.length || !(dow in ROTATION)) return null;
+  const key = rankedJointKeys[Math.min(ROTATION[dow], rankedJointKeys.length - 1)];
+  const fam = (key ?? "").split("_")[0];
+  return AREA_BY_FAMILY[fam] ?? null;
+}
+
+export interface Pref {
+  reminder_time: string | null; timezone: string | null;
+  email_reminders: boolean | null; protocol_opt_in_at: string | null;
+}
+export interface Candidate {
+  user_id: string;
+  email: string | null;
+  full_name: string | null;
+  active_sport: string | null;
+  base_status: string | null;
+  marketing_opt_out: boolean | null;
+  is_test: boolean;
+  deletion_requested: boolean;
+  pref: Pref | null;
+  /** Full assessments only (quick re-checks excluded when check_kind exists), newest first. */
+  full_assessments: { id: string; assessed_at: string; red_flag_triggered: boolean | null }[];
+  /** protocols.joint_key for the newest assessment, priority_rank ascending. */
+  ranked_joint_keys: string[];
+  /** protocol_sessions.logged_at values at or after the assessment. */
+  sessions_since: string[];
+  /** Newest ai_messages.created_at with role 'user', or null. */
+  last_user_message_at: string | null;
+  /** user_mobility_schedule.next_check_at (P1-07), or null when the row or table is absent. */
+  next_check_at: string | null;
+}
+
+export type SkipReason =
+  | "not_audience" | "not_base_active" | "test_account" | "deletion_requested" | "no_assessment" | "not_first_assessment"
+  | "red_flag" | "no_plan" | "outside_send_window" | "not_day3" | "recent_rombot_message" | "branch_c_recent_session"
+  | "no_next_check";
+export type EmailSkip =
+  | "not_opted_in" | "marketing_opt_out" | "no_email" | "not_plan_day" | "not_base_brand";
+
+export interface Planned {
+  user_id: string; assessment_id: string; branch: Branch; rendered: Rendered;
+  /** Claim ids in email_sends (unique on user_id, email_id). One in-app note and at most one email per assessment, ever. */
+  note_id: string; email_id: string;
+  /** null = the email fallback goes out with the note; otherwise why it is skipped (the in-app note is kept). */
+  email_skip: EmailSkip | null;
+  email: string | null;
+  local_date: string; send: SendTime;
+}
+
+/** P1-01 consent: the Plan day reminders toggle is on AND carries the explicit opt-in marker (set only by set_reminder_opt_in).
+ *  Same rule as lifecycle-emails explicitOn(pref, "protocol"); a test pins the two equal. */
+export function protocolOptedIn(p: Pref | null): boolean {
+  if (!p || p.email_reminders !== true) return false;
+  const m = p.protocol_opt_in_at;
+  return typeof m === "string" && Number.isFinite(Date.parse(m));
+}
+export function isPlanDay(dow: number, days: readonly number[] = PLAN_DAYS): boolean { return days.includes(dow); }
+export function isBaseBrand(sport: string | null | undefined): boolean { return sport !== "bjj" && sport !== "bodybuilding"; }
+
+export function plan(now: Date, cands: Candidate[], opts: { all: boolean; canary: ReadonlySet<string>; planDays?: readonly number[] }) {
+  const due: Planned[] = [];
+  const skipped: Partial<Record<SkipReason, number>> = {};
+  const emailSkipped: Partial<Record<EmailSkip, number>> = {};
+  const skip = (r: SkipReason) => { skipped[r] = (skipped[r] ?? 0) + 1; };
+  for (const c of cands) {
+    if (!opts.all && !opts.canary.has(c.user_id.toLowerCase())) { skip("not_audience"); continue; }
+    if (c.base_status !== "active") { skip("not_base_active"); continue; }
+    if (c.is_test) { skip("test_account"); continue; }
+    if (c.deletion_requested) { skip("deletion_requested"); continue; }
+    const a = c.full_assessments[0];
+    if (!a) { skip("no_assessment"); continue; }
+    if (c.full_assessments.length !== 1) { skip("not_first_assessment"); continue; }
+    if (a.red_flag_triggered === true) { skip("red_flag"); continue; }
+    const st = sendTime(c.pref);
+    const lp = localParts(now, st.tz);
+    const at = Date.parse(a.assessed_at);
+    if (!Number.isFinite(at)) { skip("no_assessment"); continue; }
+    if (lp.date !== ymdAdd(localParts(new Date(at), st.tz).date, CHECKIN_DAY)) { skip("not_day3"); continue; }
+    if (!inWindow(lp.hour, st.hour)) { skip("outside_send_window"); continue; }
+    const area = todayArea(c.ranked_joint_keys, lp.dow);
+    if (!area) { skip("no_plan"); continue; }
+    const lastMsg = c.last_user_message_at ? Date.parse(c.last_user_message_at) : NaN;
+    if (Number.isFinite(lastMsg) && now.getTime() - lastMsg < RECENT_ROMBOT_MESSAGE_HOURS * 3600000) { skip("recent_rombot_message"); continue; }
+    const sessions = c.sessions_since.filter((s) => Number.isFinite(Date.parse(s)) && Date.parse(s) >= at);
+    const n = sessions.length;
+    const branch = branchFor(n);
+    let nextCheck: string | null = null;
+    if (branch === "C") {
+      const newest = Math.max(...sessions.map((s) => Date.parse(s)));
+      if (now.getTime() - newest < BRANCH_C_RECENT_SESSION_HOURS * 3600000) { skip("branch_c_recent_session"); continue; }
+      // One source with lifecycle-emails (W1): next_check_at only, no 7-day or 42-day math. Never a past date.
+      const nc = c.next_check_at && Number.isFinite(Date.parse(c.next_check_at)) ? c.next_check_at : null;
+      if (!nc || localParts(new Date(Date.parse(nc)), st.tz).date <= lp.date) { skip("no_next_check"); continue; }
+      nextCheck = shortDate(nc, st.tz);
+      if (!nextCheck) { skip("no_next_check"); continue; }
+    }
+    const f: Fill = { first_name: firstName(c.full_name), today_area: area, n, next_check_date: nextCheck };
+    const rendered = render(branch, f);
+    let email_skip: EmailSkip | null = null;
+    if (!protocolOptedIn(c.pref)) email_skip = "not_opted_in";
+    else if (c.marketing_opt_out === true) email_skip = "marketing_opt_out";
+    else if (!c.email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(c.email)) email_skip = "no_email";
+    else if (!isPlanDay(lp.dow, opts.planDays ?? PLAN_DAYS)) email_skip = "not_plan_day";
+    else if (!isBaseBrand(c.active_sport)) email_skip = "not_base_brand";
+    if (email_skip) emailSkipped[email_skip] = (emailSkipped[email_skip] ?? 0) + 1;
+    due.push({
+      user_id: c.user_id, assessment_id: a.id, branch, rendered,
+      note_id: `checkin-d3-${a.id}`, email_id: `checkin-d3-email-${a.id}`,
+      email_skip, email: email_skip ? null : c.email, local_date: lp.date, send: st,
+    });
+  }
+  return { due, skipped, emailSkipped };
+}
+
+/** In-app message text: Stacy's first and last lines. The button is carried in context_snapshot for the client to draw. */
+export function noteContent(r: Rendered): string { return `${r.line1}\n${r.line3}`; }
+export const APP_PATH = "/dashboard/my-protocol?src=checkin-d3";
+
+export function maskEmail(e: string): string {
+  const [l, d] = e.split("@");
+  return `${(l ?? "").slice(0, 1)}***@${d ?? ""}`;
+}
diff --git a/supabase/functions/rombot-checkin/test/crisis.test.ts b/supabase/functions/rombot-checkin/test/crisis.test.ts
new file mode 100644
index 0000000..7da3ba7
--- /dev/null
+++ b/supabase/functions/rombot-checkin/test/crisis.test.ts
@@ -0,0 +1,45 @@
+// P1-17 crisis routing: replies to the check-in go to ai-chat in the same (user-owned) conversation, so the LIVE ai-chat crisis
+// route (v96, unconditional, runs before any model call, Stacy v3 replies) answers pain or red-flag replies. This build adds NO
+// trigger and NO words and does not touch ai-chat (Nov 3 lesson: do not widen the crisis triggers; L954 bare "numb"/"emergency"
+// stay unmatched). The live handler is not in this repo, so this test runs against a pinned copy of live v96 when
+// AI_CHAT_HANDLER points at it (sha256 below), and is ignored otherwise.
+import { assert, assertEquals } from "jsr:@std/assert@1";
+import { noteFor } from "../source/handler.ts";
+import { plan } from "../source/logic.ts";
+import { ALL, at, cand } from "./fixtures.ts";
+
+const LIVE_V96_HANDLER_SHA256 = "24f61509de9fc132a3da9b558fd13ecfc065455c014716153ba9b96cf0fc4554";
+const path = Deno.env.get("AI_CHAT_HANDLER");
+const note = noteFor(plan(at("2026-11-16T12:30:00Z"), [cand()], ALL).due[0]);
+
+Deno.test({
+  name: "live ai-chat v96 crisis route answers pain or red-flag replies in the check-in conversation; benign replies go to ROMBot",
+  ignore: !path,
+  fn: async () => {
+    const bytes = await Deno.readFile(path!);
+    const sha = [...new Uint8Array(await crypto.subtle.digest("SHA-256", bytes))].map((b) => b.toString(16).padStart(2, "0")).join("");
+    assertEquals(sha, LIVE_V96_HANDLER_SHA256);
+    const m = await import(path!);
+    const history = [{ role: note.message.role, content: note.message.content }];
+    // Self-harm and crisis-number replies: Reply A. Emergency (chest pain, fainting, broken bone): Reply B. Words are ai-chat's own.
+    for (const t of ["I want to hurt myself", "what's the crisis line number", "I have chest pain when I do it"]) {
+      const k = m.detectCrisis(t, history);
+      assert(k === "A" || k === "B", t);
+      assert(m.crisisReply(k) === m.CRISIS_REPLY_A || m.crisisReply(k) === m.CRISIS_REPLY_B);
+    }
+    assertEquals(m.detectCrisis("I passed out after the stretch", history), "B");
+    // Ordinary replies to Stacy's prompts are not crisis-routed (no new triggers added by P1-17).
+    for (const t of ["it felt too easy", "work got in the way", "my hips feel tight", "yes"]) assertEquals(m.detectCrisis(t, history), null, t);
+    // The check-in note is not Reply A, so it cannot switch on the soft-distress follow-up rule.
+    assert(note.message.content !== m.CRISIS_REPLY_A);
+  },
+});
+Deno.test("the check-in chat is owned by the user, so ai-chat's ownership check (FG-06) lets replies in and the crisis route runs", async () => {
+  assertEquals(note.user_id, cand().user_id);
+  if (!path) return;
+  const m = await import(path);
+  const rows = [{ id: "c1", user_id: note.user_id }];
+  const client = { from: () => { const f: Record<string, string> = {}; const q = { select: () => q, eq: (k: string, v: string) => { f[k] = v; return q; }, maybeSingle: () => Promise.resolve({ data: rows.find((r) => r.id === f.id && r.user_id === f.user_id) ?? null }) }; return q; } };
+  assertEquals(await m.conversationOwnedBy(client, "c1", note.user_id), true);
+  assertEquals(await m.conversationOwnedBy(client, "c1", "someone-else"), false);
+});
