 export function ackText(basePrice: string, sportPack?: string | null, sportPrice?: string | null): string {
   return ["Your subscription terms", ...ackLines(basePrice, sportPack, sportPrice).map((l) => `- ${l}`), "", ackFooter()].join("\n");
