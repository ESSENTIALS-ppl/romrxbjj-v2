+import "jsr:@supabase/functions-js/edge-runtime.d.ts";
+import { createClient } from "jsr:@supabase/supabase-js@2";
+import { handle, flagOn } from "./handler.ts";
+
+Deno.serve((req: Request) =>
+  handle(req, {
+    exportOn: flagOn(Deno.env.get("EXPORT_MY_DATA")),
+    // The caller's own JWT: RLS applies. No service-role key is read by this function.
+    userClient: (authHeader: string) =>
+      createClient(Deno.env.get("SUPABASE_URL")!, Deno.env.get("SUPABASE_ANON_KEY")!, { global: { headers: { Authorization: authHeader } } }),
+  })
+);
diff --git a/supabase/migrations-unapplied/20261117120000_p1_18_session_feedback.sql b/supabase/migrations-unapplied/20261117120000_p1_18_session_feedback.sql
new file mode 100644
index 0000000..669d778
--- /dev/null
+++ b/supabase/migrations-unapplied/20261117120000_p1_18_session_feedback.sql
@@ -0,0 +1,104 @@
+-- 20261117120000_p1_18_session_feedback (UNAPPLIED; build only). P1-18, L1031.
+-- Creates public.session_feedback exactly per JULES-P1-18-SESSION-FEEDBACK-SPEC-20261116.md
+-- (sha256 272c95a3b7a57586e2c17412223b5acb39724bd514c610405b62064dcebceeec).
+-- Stacy privacy conditions (Grant steering, 7:12 PM ET Nov 16):
+--   (1) rows, including the note, never reach OpenAI or ROMBot/ai-chat context;
+--   (2) nothing goes to Meta (Pixel or CAPI) beyond a no-answers event, and no third-party
+--       other than Notion gets the data (this build adds no Notion webhook; feedback-to-notion
+--       stays on client_feedback only);
+--   (3) rows are deleted with the account: user_id REFERENCES auth.users(id) ON DELETE CASCADE
+--       (same as public.protocol_sessions.user_id);
+--   (4) the AFTER INSERT event trigger writes product_events event session_feedback_submitted
+--       with props holding only ids and timestamps (id, session_id, created_at). It does NOT
+--       copy feel, clear, length_fit, has_survey, or the note text. This is stricter than the
+--       Jules spec's props { feel, has_survey }; the table itself matches the spec exactly.
+-- No data backfill. Apply via MCP apply_migration only, after its own gate. EXPORT_MY_DATA stays off.
+-- Rollback: 20261117120000_p1_18_session_feedback_rollback.sql.
+
+CREATE TABLE public.session_feedback (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
+  session_id uuid NOT NULL REFERENCES public.protocol_sessions(id) ON DELETE CASCADE,
+  session_date date NOT NULL,
+  feel text NOT NULL,
+  clear text,
+  length_fit text,
+  note text,
+  sport text NOT NULL DEFAULT 'base',
+  source text NOT NULL DEFAULT 'web',
+  created_at timestamptz NOT NULL DEFAULT now(),
+  CONSTRAINT session_feedback_session_id_key UNIQUE (session_id),
+  CONSTRAINT session_feedback_feel_check CHECK (feel IN ('easy', 'about_right', 'hard')),
+  CONSTRAINT session_feedback_clear_check CHECK (clear IS NULL OR clear IN ('yes', 'somewhat', 'no')),
+  CONSTRAINT session_feedback_length_fit_check CHECK (length_fit IS NULL OR length_fit IN ('too_short', 'about_right', 'too_long')),
+  CONSTRAINT session_feedback_note_check CHECK (note IS NULL OR char_length(note) BETWEEN 1 AND 500),
+  CONSTRAINT session_feedback_sport_check CHECK (sport = 'base'),
+  CONSTRAINT session_feedback_source_check CHECK (source = 'web')
+);
+
+CREATE INDEX session_feedback_user_created_idx
+  ON public.session_feedback (user_id, created_at DESC);
+
+COMMENT ON TABLE public.session_feedback IS
+  'P1-18 (20261117120000, unapplied). One row per protocol session (unique session_id). Write-once from the signed-in user. The note and answers stay on this table; they are not copied to product_events, ai-chat, or ROMBot context, and this table has no Notion/Meta webhook.';
+
+COMMENT ON COLUMN public.session_feedback.note IS
+  'Optional free text, 1 to 500 characters. Never copied to product_events, OpenAI, ROMBot, Meta, or Notion.';
+
+ALTER TABLE public.session_feedback ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY session_feedback_insert_own
+  ON public.session_feedback
+  FOR INSERT
+  TO authenticated
+  WITH CHECK (
+    (SELECT auth.uid()) = user_id
+    AND EXISTS (
+      SELECT 1
+      FROM public.protocol_sessions ps
+      WHERE ps.id = session_id
+        AND ps.user_id = (SELECT auth.uid())
+        AND ps.session_date = session_feedback.session_date
+    )
+  );
+
+CREATE POLICY session_feedback_select_own
+  ON public.session_feedback
+  FOR SELECT
+  TO authenticated
+  USING ((SELECT auth.uid()) = user_id);
+
+REVOKE ALL ON TABLE public.session_feedback FROM PUBLIC, anon, authenticated;
+GRANT SELECT, INSERT ON TABLE public.session_feedback TO authenticated;
+-- service_role keeps default full access (BYPASSRLS). No UPDATE or DELETE policy: write-once from the client.
+
+CREATE OR REPLACE FUNCTION public.tg_pe_session_feedback()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path TO 'public', 'pg_temp'
+AS $$
+BEGIN
+  -- Stacy (4): payload holds only ids, timestamps, and the event name. No answers, no note.
+  PERFORM public.log_product_event(
+    NEW.user_id,
+    'session_feedback_submitted',
+    jsonb_build_object(
+      'id', NEW.id,
+      'session_id', NEW.session_id,
+      'created_at', NEW.created_at
+    )
+  );
+  RETURN NEW;
+END;
+$$;
+
+COMMENT ON FUNCTION public.tg_pe_session_feedback() IS
+  'P1-18. AFTER INSERT on session_feedback: product_events session_feedback_submitted with props id, session_id, created_at only. Never copies feel, clear, length_fit, has_survey, or note.';
+
+REVOKE ALL ON FUNCTION public.tg_pe_session_feedback() FROM PUBLIC, anon, authenticated;
+
+CREATE TRIGGER trg_pe_session_feedback
+  AFTER INSERT ON public.session_feedback
+  FOR EACH ROW
+  EXECUTE FUNCTION public.tg_pe_session_feedback();
diff --git a/supabase/migrations-unapplied/20261117120000_p1_18_session_feedback_rollback.sql b/supabase/migrations-unapplied/20261117120000_p1_18_session_feedback_rollback.sql
new file mode 100644
index 0000000..5f7990f
--- /dev/null
+++ b/supabase/migrations-unapplied/20261117120000_p1_18_session_feedback_rollback.sql
@@ -0,0 +1,9 @@
+-- ROLLBACK for 20261117120000_p1_18_session_feedback (UNAPPLIED companion).
+-- Drops the P1-18 trigger, function, and table (policies and indexes go with the table).
+-- Does not change public.protocol_sessions, public.product_events, public.log_product_event,
+-- public.client_feedback, or any webhook. Does not delete already-written product_events rows
+-- (none exist until this is applied and a row is inserted). No data in session_feedback until apply.
+
+DROP TRIGGER IF EXISTS trg_pe_session_feedback ON public.session_feedback;
+DROP FUNCTION IF EXISTS public.tg_pe_session_feedback();
+DROP TABLE IF EXISTS public.session_feedback;
diff --git a/supabase/migrations-unapplied/20261117120100_p1_18_assessment_feedback.sql b/supabase/migrations-unapplied/20261117120100_p1_18_assessment_feedback.sql
new file mode 100644
index 0000000..b040c51
--- /dev/null
+++ b/supabase/migrations-unapplied/20261117120100_p1_18_assessment_feedback.sql
@@ -0,0 +1,105 @@
+-- 20261117120100_p1_18_assessment_feedback (UNAPPLIED; build only). P1-18b, L1031.
+-- Creates public.assessment_feedback exactly per JULES-P1-18B-ASSESSMENT-FEEDBACK-SPEC-20261116.md
+-- (sha256 7b42dd84b0f2549b7dfbf248f22721503279d8f3df6c6f49f0146a1efb36bbff), with two tightenings:
+--   1) INSERT is allowed only when the assessment is the caller's own AND check_kind = 'full'.
+--      The Jules draft used "check_kind IS DISTINCT FROM 'quick'" (NULL would count as full).
+--      After live L1134 031000 (20261116143905) the column is NOT NULL and is only 'full' or 'quick'.
+--      Grant/Stacy require FULL only, and that partial or quick rows and other users' assessments are
+--      rejected, so the policy requires equality to 'full'. A non-full kind (quick, or a 'partial'
+--      kind if one were ever added) cannot get a row.
+--   2) The event trigger writes product_events event assessment_feedback_submitted with props holding
+--      only ids and timestamps (id, assessment_id, created_at). It does NOT copy ease, results_clear,
+--      check_again, or survey_version (Jules asked for those four as props; Stacy: no answers, and
+--      there is no free-text column on this table anyway).
+-- Ordered after the session_feedback unapplied file 20261117120000, and after live 031000
+-- (20261116143905 assessment_check_kind). This SQL reads assessments.check_kind; do not apply before 031000.
+-- Stacy privacy (same as session_feedback): rows never reach OpenAI or ROMBot/ai-chat; nothing to Meta
+-- beyond a no-answers event (this build adds no Meta or Notion hook); deleted with the account
+-- (user_id REFERENCES public.users(id) ON DELETE CASCADE, matching assessments.user_id; public.users.id
+-- itself references auth.users(id) ON DELETE CASCADE); export-my-data coverage, flag stays off.
+-- Apply via MCP apply_migration only, after its own gate, and only after 031000 and (if applying both)
+-- after 20261117120000 is live or this is applied as a later id. Combined rollback:
+-- 20261117120100_p1_18_feedback_tables_rollback.sql (drops this table, then session_feedback).
+
+CREATE TABLE public.assessment_feedback (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  user_id uuid NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
+  assessment_id uuid NOT NULL REFERENCES public.assessments(id) ON DELETE CASCADE,
+  ease text NOT NULL,
+  results_clear text NOT NULL,
+  check_again text NOT NULL,
+  survey_version text NOT NULL,
+  sport text NOT NULL DEFAULT 'base',
+  source text NOT NULL DEFAULT 'web',
+  created_at timestamptz NOT NULL DEFAULT now(),
+  CONSTRAINT assessment_feedback_assessment_id_key UNIQUE (assessment_id),
+  CONSTRAINT assessment_feedback_ease_check CHECK (ease IN ('easy', 'okay', 'hard')),
+  CONSTRAINT assessment_feedback_results_clear_check CHECK (results_clear IN ('yes', 'mostly', 'no')),
+  CONSTRAINT assessment_feedback_check_again_check CHECK (check_again IN ('yes', 'maybe', 'no')),
+  CONSTRAINT assessment_feedback_survey_version_check CHECK (survey_version = 'p1-18b-card1-2026-11-16'),
+  CONSTRAINT assessment_feedback_sport_check CHECK (sport = 'base'),
+  CONSTRAINT assessment_feedback_source_check CHECK (source = 'web')
+);
+
+CREATE INDEX assessment_feedback_user_created_idx
+  ON public.assessment_feedback (user_id, created_at DESC);
+
+COMMENT ON TABLE public.assessment_feedback IS
+  'P1-18b (20261117120100, unapplied). One row per full assessment (unique assessment_id). Write-once from the signed-in user. No free-text column. INSERT is allowed only for the caller''s own assessments with check_kind = ''full'' (quick and any non-full kind, including partial, are rejected). Answers are not copied to product_events, ai-chat, ROMBot, Meta, or Notion.';
+
+ALTER TABLE public.assessment_feedback ENABLE ROW LEVEL SECURITY;
+
+CREATE POLICY assessment_feedback_insert_own
+  ON public.assessment_feedback
+  FOR INSERT
+  TO authenticated
+  WITH CHECK (
+    (SELECT auth.uid()) = user_id
+    AND EXISTS (
+      SELECT 1
+      FROM public.assessments a
+      WHERE a.id = assessment_id
+        AND a.user_id = (SELECT auth.uid())
+        AND a.check_kind = 'full'
+    )
+  );
+
+CREATE POLICY assessment_feedback_select_own
+  ON public.assessment_feedback
+  FOR SELECT
+  TO authenticated
+  USING ((SELECT auth.uid()) = user_id);
+
+REVOKE ALL ON TABLE public.assessment_feedback FROM PUBLIC, anon, authenticated;
+GRANT SELECT, INSERT ON TABLE public.assessment_feedback TO authenticated;
+
+CREATE OR REPLACE FUNCTION public.tg_pe_assessment_feedback()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path TO 'public', 'pg_temp'
+AS $$
+BEGIN
+  -- Stacy: payload holds only ids, timestamps, and the event name. No answers.
+  PERFORM public.log_product_event(
+    NEW.user_id,
+    'assessment_feedback_submitted',
+    jsonb_build_object(
+      'id', NEW.id,
+      'assessment_id', NEW.assessment_id,
+      'created_at', NEW.created_at
+    )
+  );
+  RETURN NEW;
+END;
+$$;
+
+COMMENT ON FUNCTION public.tg_pe_assessment_feedback() IS
+  'P1-18b. AFTER INSERT on assessment_feedback: product_events assessment_feedback_submitted with props id, assessment_id, created_at only. Never copies ease, results_clear, check_again, or survey_version.';
+
+REVOKE ALL ON FUNCTION public.tg_pe_assessment_feedback() FROM PUBLIC, anon, authenticated;
+
+CREATE TRIGGER trg_pe_assessment_feedback
+  AFTER INSERT ON public.assessment_feedback
+  FOR EACH ROW
+  EXECUTE FUNCTION public.tg_pe_assessment_feedback();
