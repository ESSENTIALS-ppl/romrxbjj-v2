+// lifecycle-emails copy and HTML (FG-09/10/11). ALL USER-FACING WORDS BELOW ARE STACY'S DRAFTS (STACY-FG-PRIORITY-CRITERIA
+// section 5) AND ARE "NEEDS JIM WORDING / Stacy clearance needed" until Jim approves them. Nothing here has been sent.
+// No scores, joint names or mood words in subject or preheader. No tracking pixels. No click-tracked links. No em dashes.
+import type { Due, Kind } from "./logic.ts";
+import { SCORE_LABEL } from "./score.ts";
+
+export interface Brand { key: "bjj" | "bodybuilding" | "base"; name: string; from: string; replyTo: string; appBase: string; settingsPath: string; }
+export const BRANDS: Record<string, Brand> = {
+  bjj: { key: "bjj", name: "ROMRxBJJ", from: "Jim Scott <jim@romrxbjj.com>", replyTo: "jim@romrxbjj.com", appBase: "https://romrxbjj.com", settingsPath: "/dashboard/settings" },
+  bodybuilding: { key: "bodybuilding", name: "ROMRxBodybuilding", from: "Jim Scott <jim@romrxbodybuilding.com>", replyTo: "jim@romrxbodybuilding.com", appBase: "https://romrxbodybuilding.com", settingsPath: "/dashboard/settings" },
+  // Base sender = the same From send-renewal-reminders v6 uses for Base subscribers (its brandFor falls back to the BJJ brand). Grant's call 6:32 PM.
+  base: { key: "base", name: "ROMRx", from: "Jim Scott <jim@romrxbjj.com>", replyTo: "jim@romrxbjj.com", appBase: "https://romrx.io/app", settingsPath: "/dashboard/settings" },
+};
+export function brandFor(sport: string | null | undefined): Brand {
+  if (sport === "bodybuilding") return BRANDS.bodybuilding;
+  if (sport === "bjj") return BRANDS.bjj;
+  return BRANDS.base;
+}
+
+type StaticKind = "retest" | "protocol" | "digest";
+export const COPY: Record<StaticKind, { subject: string; preheader: string; lines: (d: Due) => string[]; button: string; path: string; why: string; off: string }> = {
+  retest: {
+    subject: "Time for your ROMRx retest",
+    preheader: "Your 6-week check-in is ready when you are.",
+    lines: () => ["It has been about six weeks since your last ROMRx assessment. Your retest is ready whenever you are."],
+    button: "Start my retest", path: "/onboarding/assessment",
+    why: "You are getting this because Retest reminders is on in your settings.", off: "Turn off retest reminders",
+  },
+  protocol: {
+    subject: "Today is a protocol day",
+    preheader: "Your ROMRx session is ready.",
+    lines: () => ["Today is a protocol day on your ROMRx plan."],
+    button: "Open today's session", path: "/dashboard/my-protocol",
+    why: "You are getting this because Email reminders is on in your settings.", off: "Turn off protocol reminders",
+  },
+  digest: {
+    subject: "Your ROMRx week",
+    preheader: "Your week in ROMRx.",
+    lines: (d) => {
+      const x = d.digest!;
+      // The number is the apps' /100 score and the label is the one the app shows (score.ts, one place). Delta is against the PREVIOUS assessment. NEEDS JIM WORDING (off).
+      const trend = x.delta === null ? "" : x.delta > 0 ? `, up ${x.delta} since your previous assessment` : x.delta < 0 ? `, down ${Math.abs(x.delta)} since your previous assessment` : ", unchanged since your previous assessment";
+      // P1-15: Stacy CLEAR (ruling 8ce215ca). Words byte-identical to the current previews.
+      const extra: string[] = [];
+      if (typeof x.sessions_this_week === "number") extra.push(`Sessions this week: ${x.sessions_this_week}.`);
+      // Next-check words come from nextCheck() in logic.ts (one source, one label) via d.next_check_line.
+      if (d.next_check_line) extra.push(d.next_check_line);
+      return ["Here is your ROMRx week.", `${SCORE_LABEL[brandFor(d.active_sport).key]}: ${x.score}${trend}.`, `Current streak: ${x.streak} ${x.streak === 1 ? "day" : "days"}.`, ...extra];
+    },
+    button: "Open ROMRx", path: "/dashboard",
+    why: "You are getting this because Weekly progress digest is on in your settings.", off: "Turn off the weekly digest",
+  },
+};
+export const ALL_OFF_TEXT = "Turn off all ROMRx emails except account and billing notices"; // NEEDS JIM WORDING (Stacy checklist item, 7704(a)(3)(B))
+
+const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+
+export const QUICK_CHECK_PATH = "/dashboard/quick-check"; // must match Jules P1-06 route
+
+export interface CopySpec {
+  subject: string; preheader: string; lines: string[]; button: string; path: string;
+  why: string; off: string; afterButton?: string[]; sentTo: boolean;
+}
+
+/** Stacy P1-16 final words, used exactly. Jim wording yes still required before any send.
+ *  Stacy P1-08 day 7 / day 14 A+B words, used exactly. */
+export function copyFor(d: Due, brand?: Brand): CopySpec {
+  if (d.kind === "check7") {
+    const retest = d.retest_date ? `Your full retest is still at 6 weeks, on ${d.retest_date}.` : "Your full retest is still at 6 weeks.";
+    return {
+      subject: "Your ROMRx quick check is ready",
+      preheader: "See your day 1 results next to today's.",
+      lines: [
+        "It has been a week since your ROMRx assessment. Your quick check is ready.",
+        "It re-measures 1 or 2 of your focus areas and shows them next to your day 1 results.",
+        retest,
+      ],
+      button: "Start my quick check", path: QUICK_CHECK_PATH,
+      why: "You're getting this because Check reminders is on in your ROMRx settings.",
+      off: "Turn off check reminders", sentTo: true,
+    };
+  }
+  if (d.kind === "check14" && d.quick_check_done) {
+    const next = d.next_check_date ? `Your next check: ${d.next_check_date}` : null;
+    return {
+      subject: "Two weeks of ROMRx",
+      preheader: "Your next check date is set.",
+      lines: [
+        "You did your quick check. Nice work.",
+        ...(next ? [next] : []),
+        "Until then, your plan is ready each day in the app.",
+      ],
+      button: "Open today's session", path: "/dashboard/my-protocol",
+      why: "You're getting this because Check reminders is on in your ROMRx settings.",
+      off: "Turn off check reminders", sentTo: true,
+    };
+  }
+  if (d.kind === "check14") {
+    const retest = d.retest_date ? `Your full retest is on ${d.retest_date}.` : "Your full retest is still at 6 weeks.";
+    return {
+      subject: "Your quick check is waiting",
+      preheader: "Two weeks in. See where you are now.",
+      lines: [
+        "It has been two weeks since your ROMRx assessment. Your quick check is ready when you are.",
+        "It shows your day 1 results next to today's for 1 or 2 of your focus areas.",
+        retest,
+      ],
+      button: "Start my quick check", path: QUICK_CHECK_PATH,
+      why: "You're getting this because Check reminders is on in your ROMRx settings.",
+      off: "Turn off check reminders", sentTo: true,
+    };
+  }
+  if (d.kind === "lapsed") {
+    const settings = brand ? `${brand.appBase}${brand.settingsPath}` : "/dashboard/settings";
+    return {
+      subject: "Your ROMRx plan is still here",
+      preheader: "Pick up where you left off.",
+      lines: [
+        "We haven't seen you in a couple of weeks. Your plan is saved and ready.",
+        "You can start again with today's session.",
+        ...(d.next_check_line ? [d.next_check_line] : []),
+      ],
+      button: "Open today's session", path: "/dashboard/my-protocol",
+      why: "You're getting this because Plan day reminders is on in your ROMRx settings.",
+      off: "Turn off plan day reminders",
+      afterButton: [`Want fewer emails? Change your reminders in Settings: ${settings}`],
+      sentTo: true,
+    };
+  }
+  const c = COPY[d.kind as StaticKind];
+  return { subject: c.subject, preheader: c.preheader, lines: c.lines(d), button: c.button, path: c.path, why: c.why, off: c.off, sentTo: false };
+}
+
+export interface Built { subject: string; html: string; text: string; headers: Record<string, string>; }
+export function buildEmail(d: Due, brand: Brand, links: { offKind: string; offAll: string; oneClick: string }, postalLine: string): Built {
+  const c = copyFor(d, brand);
+  const open = `${brand.appBase}${c.path}`;
+  const hello = `Hi ${esc(d.first_name)},`;
+  const after = (c.afterButton ?? []).map((l) => `    <p style="font-size:12px;color:#5a7070;margin-top:16px;line-height:1.6;">${esc(l)}</p>`).join("\n");
+  const sentTo = c.sentTo ? `This message was sent to ${d.email}.` : "";
+  const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"></head>
+<body style="margin:0;padding:0;background:#f8fcfc;font-family:Inter,system-ui,sans-serif;">
+<div style="display:none;max-height:0;overflow:hidden;">${esc(c.preheader)}</div>
+<div style="max-width:600px;margin:0 auto;padding:32px 24px;">
+  <div style="margin-bottom:24px;"><span style="font-family:Georgia,serif;font-size:22px;font-weight:700;color:#1a2e2e;">${esc(brand.name)}</span></div>
+  <div style="background:#fff;border-radius:12px;border:1px solid #cde0e0;padding:32px;">
+    <p style="font-size:14px;color:#1a2e2e;line-height:1.7;margin:0 0 12px;">${hello}</p>
+${c.lines.map((l) => `    <p style="font-size:14px;color:#1a2e2e;line-height:1.7;margin:0 0 12px;">${esc(l)}</p>`).join("\n")}
+    <a href="${esc(open)}" style="display:inline-block;background:#1a2e2e;color:#fff;text-decoration:none;padding:12px 24px;border-radius:10px;font-size:13px;font-weight:600;margin-top:8px;">${esc(c.button)}</a>${after ? "\n" + after : ""}
+    <p style="font-size:12px;color:#5a7070;margin-top:24px;line-height:1.6;">${esc(c.why)} <a href="${esc(links.offKind)}" style="color:#008080;">${esc(c.off)}</a></p>
+    <p style="font-size:12px;color:#5a7070;line-height:1.6;"><a href="${esc(links.offAll)}" style="color:#008080;">${esc(ALL_OFF_TEXT)}</a></p>
+  </div>
+  <p style="font-size:11px;color:#5a7070;text-align:center;margin-top:20px;">${esc(postalLine)}<br /><a href="mailto:${esc(brand.replyTo)}" style="color:#008080;">${esc(brand.replyTo)}</a>${c.sentTo ? `<br />${esc(sentTo)}` : ""}</p>
+</div></body></html>`;
+  const textParts = [hello.replace(/&amp;/g, "&"), "", ...c.lines, "", `${c.button}: ${open}`];
+  if (c.afterButton?.length) textParts.push("", ...c.afterButton);
+  textParts.push("", `${c.why} ${c.off}: ${links.offKind}`, `${ALL_OFF_TEXT}: ${links.offAll}`, "", postalLine);
+  if (c.sentTo) textParts.push(brand.replyTo, sentTo);
+  const text = textParts.join("\n");
+  return {
+    subject: c.subject, html, text,
+    // RFC 8058 one-click: the header URL takes a POST only (a GET to it redirects to the confirm page and applies nothing). Signed scoped token only, no email address.
+    headers: { "List-Unsubscribe": `<${links.oneClick}>`, "List-Unsubscribe-Post": "List-Unsubscribe=One-Click" },
+  };
+}
diff --git a/supabase/functions/lifecycle-emails/source/handler.ts b/supabase/functions/lifecycle-emails/source/handler.ts
new file mode 100644
index 0000000..7ee2ce2
--- /dev/null
+++ b/supabase/functions/lifecycle-emails/source/handler.ts
@@ -0,0 +1,78 @@
+// lifecycle-emails handler (FG-09/10/11). Staged 2026-11-02, nothing deployed, nothing set.
+// All I/O is injected so every rule is testable without a network. Default is DRY RUN: real sends need
+// LIFECYCLE_EMAILS_SEND to be exactly "on". Audience is canary-only unless LIFECYCLE_AUDIENCE is exactly "all".
+import { audienceAll, type Candidate, type Due, flagOn, KINDS, type Kind, maskEmail, planKind } from "./logic.ts";
+import { brandFor, buildEmail } from "./email.ts";
+import { POSTAL_LINE } from "../_shared/email_footer.ts";
+import { signUnsubToken, type UnsubScope } from "../_shared/unsub_token.ts";
+
+export interface Deps {
+  env: (k: string) => string | undefined;
+  cronOk: (req: Request) => Promise<boolean>;
+  now: () => Date;
+  /** Loads candidates for the given kinds. Must only return users with at least one lifecycle toggle on. */
+  load: (kinds: Kind[]) => Promise<Candidate[]>;
+  /** true = this run owns the send. false = already claimed (no-op). Throws on a real error. */
+  claim: (userId: string, emailId: string) => Promise<boolean>;
+  release: (userId: string, emailId: string) => Promise<void>;
+  send: (p: { from: string; replyTo: string; to: string; subject: string; html: string; text: string; headers: Record<string, string> }) => Promise<boolean>;
+}
+
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+export function idList(v: string | null | undefined): Set<string> {
+  return new Set((v ?? "").split(",").map((s) => s.trim().toLowerCase()).filter((s) => UUID_RE.test(s)));
+}
+/** Where the opt-out links point. Brand site hosts the page; `unsubscribe` v9 verifies the token. */
+export const UNSUB_BASE = "https://cqzvqzwwevnflinxgnpp.supabase.co/functions/v1/unsubscribe";
+/** Visible footer links go to the brand's confirm page (the site's React unsubscribe route; applies nothing until the button is pressed). Same fixed map as unsubscribe v9. */
+export const CONFIRM_PAGES: Record<string, string> = {
+  bjj: "https://romrxbjj.com/unsubscribe", bodybuilding: "https://romrxbodybuilding.com/unsubscribe", base: "https://romrx.io/app/unsubscribe",
+};
+
+export async function handle(req: Request, d: Deps): Promise<Response> {
+  const json = (b: unknown, status = 200) => new Response(JSON.stringify(b), { status, headers: { "Content-Type": "application/json", "Cache-Control": "no-store" } });
+  if (!(await d.cronOk(req))) return new Response("forbidden", { status: 403 });
+  const url = new URL(req.url);
+  const dryParam = url.searchParams.get("dry_run") === "1";
+  const sendOn = flagOn(d.env("LIFECYCLE_EMAILS_SEND")) && !dryParam;
+  const all = audienceAll(d.env("LIFECYCLE_AUDIENCE"));
+  const canary = idList(d.env("LIFECYCLE_CANARY_USER_IDS"));
+  const suppress = idList(d.env("LIFECYCLE_SUPPRESS_USER_IDS")); // pending deletion requests are emailed, not stored in the DB
+  const only = url.searchParams.get("kind");
+  const kinds = KINDS.filter((k) => !only || k === only);
+  const secret = d.env("UNSUBSCRIBE_HMAC_SECRET");
+  const now = d.now();
+
+  const loaded = (await d.load([...kinds])).map((c) => suppress.has(c.user_id.toLowerCase()) ? { ...c, deletion_requested: true } : c);
+  const plan: Record<string, { due: Due[]; skipped: Record<string, number> }> = {};
+  for (const k of kinds) {
+    const p = planKind(k, now, loaded, { all, canary });
+    plan[k] = { due: p.due, skipped: p.skipped as Record<string, number> };
+  }
+  if (!sendOn) {
+    return json({
+      success: true, dry_run: true, send_enabled: false, audience: all ? "all" : "canary", canary_count: canary.size, date: now.toISOString(),
+      kinds: Object.fromEntries(kinds.map((k) => [k, { due: plan[k].due.map((x) => ({ email: maskEmail(x.email), email_id: x.email_id })), skipped: plan[k].skipped }])),
+    });
+  }
+  if (!all && canary.size === 0) return json({ success: true, send_enabled: true, audience: "canary", note: "no canary ids set; nothing sent" });
+  const out: Record<string, { sent: number; already: number; failed: number }> = {};
+  for (const k of kinds) {
+    const r = (out[k] = { sent: 0, already: 0, failed: 0 });
+    for (const x of plan[k].due) {
+      const scopeKind = k as UnsubScope;
+      const [tKind, tAll] = [await signUnsubToken(secret, x.user_id, scopeKind), await signUnsubToken(secret, x.user_id, "all")];
+      if (!tKind || !tAll) { r.failed++; continue; } // fail closed: no signing secret, no email without opt-out links
+      const brand = brandFor(x.active_sport);
+      const built = buildEmail(x, brand, { offKind: `${CONFIRM_PAGES[brand.key]}?t=${tKind}`, offAll: `${CONFIRM_PAGES[brand.key]}?t=${tAll}`, oneClick: `${UNSUB_BASE}?t=${tKind}&b=${brand.key}` }, POSTAL_LINE);
+      try {
+        if (!(await d.claim(x.user_id, x.email_id))) { r.already++; continue; }
+      } catch { r.failed++; continue; }
+      let ok = false;
+      try { ok = await d.send({ from: brand.from, replyTo: brand.replyTo, to: x.email, subject: built.subject, html: built.html, text: built.text, headers: built.headers }); } catch { ok = false; }
+      if (ok) r.sent++;
+      else { r.failed++; try { await d.release(x.user_id, x.email_id); } catch { /* next hourly run retries inside the window */ } }
+    }
+  }
+  return json({ success: true, send_enabled: true, audience: all ? "all" : "canary", date: now.toISOString(), results: out });
+}
diff --git a/supabase/functions/lifecycle-emails/source/index.ts b/supabase/functions/lifecycle-emails/source/index.ts
new file mode 100644
index 0000000..cf2e196
--- /dev/null
+++ b/supabase/functions/lifecycle-emails/source/index.ts
@@ -0,0 +1,101 @@
+// lifecycle-emails (from live v1) + P1-15 digest lines + P1-16 lapsed + P1-08 day 7 / day 14. Base From left as live (Jim Scott <jim@romrxbjj.com>). No P1-02 audience/sender rewrite. BRANCH ONLY: not deployed.
+// Cron-only (x-cron-secret via public.verify_webhook_secret, fail closed). Dry run unless LIFECYCLE_EMAILS_SEND === "on".
+import "jsr:@supabase/functions-js/edge-runtime.d.ts";
+import { createClient } from "jsr:@supabase/supabase-js@2";
+import { handle } from "./handler.ts";
+import { explicitOn, type Candidate, type Kind } from "./logic.ts";
+import { appScore, latestTwoFull } from "./score.ts";
+import { deletionRequested } from "./deletion.ts";
+
+const SUPABASE_URL = Deno.env.get("SUPABASE_URL")!;
+const KEY = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
+const RESEND_API_KEY = Deno.env.get("RESEND_API_KEY") ?? "";
+const sb = createClient(SUPABASE_URL, KEY);
+
+async function cronOk(req: Request): Promise<boolean> {
+  const got = (req.headers.get("x-cron-secret") ?? "").trim();
+  if (got.length < 32) return false;
+  try {
+    const r = await fetch(`${SUPABASE_URL}/rest/v1/rpc/verify_webhook_secret`, {
+      method: "POST",
+      headers: { apikey: KEY, Authorization: `Bearer ${KEY}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ p_name: "cron_webhook_secret", p_candidate: got }),
+    });
+    return r.ok && (await r.json()) === true;
+  } catch { return false; }
+}
+
+const iso = (d: Date) => d.toISOString();
+async function load(kinds: Kind[]): Promise<Candidate[]> {
+  const toggleOf = (k: Kind) => (k === "protocol" || k === "lapsed") ? "email_reminders.eq.true" : k === "digest" ? "weekly_digest.eq.true" : "retest_reminders.eq.true";
+  const toggles = [...new Set(kinds.map(toggleOf))].join(",");
+  const { data: prefs, error } = await sb.from("notification_preferences")
+    .select("user_id, reminder_time, timezone, retest_reminders, email_reminders, weekly_digest, created_at, updated_at, retest_opt_in_at, protocol_opt_in_at, digest_opt_in_at").or(toggles).limit(5000);
+  if (error) throw new Error("prefs load failed");
+  // Only users with an EXPLICIT saved-on toggle for at least one requested kind are loaded further.
+  const keep = (prefs ?? []).filter((p) => kinds.some((k) => explicitOn(p as never, k)));
+  const out: Candidate[] = [];
+  // Hip flexion cutover, read the way the apps read it. Missing or unreadable = null = everything treated as pre-cutover (same as the apps).
+  let cutMs: number | null = null;
+  try {
+    const { data: cut } = await sb.from("scoring_cutovers").select("effective_at").eq("key", "hip_flex_scored").maybeSingle();
+    const t = Date.parse(String((cut as Record<string, unknown> | null)?.effective_at ?? ""));
+    cutMs = Number.isFinite(t) ? t : null;
+  } catch { cutMs = null; }
+  for (const p of keep) {
+    const { data: u } = await sb.from("users").select("id, email, full_name, active_sport, marketing_opt_out").eq("id", p.user_id).maybeSingle();
+    if (!u) continue;
+    // Newest two FULL assessments (quick re-checks skipped), ordered like My Body (assessed_at desc). Delta is newest vs the one immediately before it.
+    const rows = await latestTwoFull(sb, p.user_id);
+    const a = rows[0] ? { id: String(rows[0].id), assessed_at: String(rows[0].assessed_at) } : null;
+    const latestScore = rows[0] ? appScore(rows[0], cutMs) : null;
+    const previousScore = rows[1] ? appScore(rows[1], cutMs) : null;
+    const { data: s } = await sb.from("protocol_sessions").select("session_date").eq("user_id", p.user_id).order("session_date", { ascending: false }).limit(90);
+    const { count } = await sb.from("protocols").select("id", { count: "exact", head: true }).eq("user_id", p.user_id);
+    let schedule: Candidate["schedule"] = null;
+    try {
+      const { data: sch, error: schErr } = await sb.from("user_mobility_schedule").select("last_assessment_id, last_assessed_at, next_retest_at, next_check_at").eq("user_id", p.user_id).maybeSingle();
+      if (!schErr && sch) schedule = sch as Candidate["schedule"];
+    } catch { schedule = null; } // table may not exist until the P1-07 030000 migration is applied; nextCheck omits the line
+    let lastSignIn: string | null = null;
+    try {
+      const { data: au } = await sb.auth.admin.getUserById(p.user_id);
+      lastSignIn = au?.user?.last_sign_in_at ?? null;
+    } catch { lastSignIn = null; }
+    let hasQuick = false;
+    try {
+      const since = schedule?.last_assessed_at ?? a?.assessed_at; // quick rows after the last full assessment only
+      if (since) {
+        const { data: q, error: qErr } = await sb.from("assessments").select("id").eq("user_id", p.user_id).eq("check_kind", "quick").gt("assessed_at", since).limit(1);
+        if (!qErr && q && q.length) hasQuick = true;
+      }
+    } catch { hasQuick = false; } // column may not exist until the P1-06 check_kind migration is applied
