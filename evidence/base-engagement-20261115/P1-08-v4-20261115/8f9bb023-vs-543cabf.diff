+}
+
+export function maskEmail(e: string): string {
+  const [l, d] = e.split("@");
+  return `${(l ?? "").slice(0, 1)}***@${d ?? ""}`;
+}
diff --git a/supabase/functions/lifecycle-emails/source/score.ts b/supabase/functions/lifecycle-emails/source/score.ts
new file mode 100644
