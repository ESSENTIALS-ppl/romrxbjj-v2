  {
   "t": "assessment_drafts",
   "name": "assessment_drafts_touch_biu",
   "def": "CREATE TRIGGER assessment_drafts_touch_biu BEFORE INSERT OR UPDATE ON public.assessment_drafts FOR EACH ROW EXECUTE FUNCTION assessment_drafts_touch()",
   "fn": "public.assessment_drafts_touch",
   "enabled": "O"
  }
 ],
 "trigger_fns": [
  {
   "fn": "public.assessment_drafts_touch",
   "def": "CREATE OR REPLACE FUNCTION public.assessment_drafts_touch()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog', 'pg_temp'\nAS $function$\nbegin\n  new.updated_at := now();\n  if tg_op = 'INSERT' then\n    new.created_at := now();\n  elsif old.expires_at <= now() then\n    new.created_at := now();\n  else\n    new.created_at := old.created_at;\n  end if;\n  new.expires_at := least(now() + interval '48 hours', new.created_at + interval '7 days');\n  return new;\nend $function$\n"
  }
 ],
