+    const banner = readFileSync(join(process.cwd(), 'src', 'components', 'QuickCheckBanner.tsx'), 'utf8')
+    const loader = readFileSync(join(process.cwd(), 'src', 'lib', 'quickCheckLoad.ts'), 'utf8')
+    expect(page.match(/select\(SCHEDULE_COLUMNS\)/g)?.length).toBe(1) // re-read after a save
+    expect(loader).toContain('select(SCHEDULE_COLUMNS)')
+    expect(page).toContain('loadQuickContext(user.id)')
+    expect(banner).toContain('loadQuickContext(userId)')
+    expect(page).toContain('47aad435')
+    expect(page).not.toMatch(/65a251b8|c8769478/)
+  })
+  it('window day 7 to 14 (Avery roll after local day 14): day 7 shows, day 14 shows, day 15 hidden after the roll', () => {
+    // Full save on Sun Nov 1, 2026, 10:00 AM ET: next_check_at = +7 days, next_retest_at = +42 days (rule 1).
+    const assessed = '2026-11-01T15:00:00.000Z'
+    const open = { next_check_at: '2026-11-08T15:00:00.000Z', next_retest_at: '2026-12-13T15:00:00.000Z', check_joints: ['hip_er_r'], last_assessed_at: assessed }
+    const day7 = new Date('2026-11-08T15:30:00.000Z')   // day 7, just after next_check_at
+    const day14 = new Date('2026-11-16T04:30:00.000Z')  // Nov 15, 11:30 PM ET: last hour of local day 14, row not rolled yet
+    expect(isQuickCheckDue(open, day7)).toBe(true)
+    expect(isQuickCheckDue(open, day14)).toBe(true)
+    // Day 15 after the roll: next_check_at = next_retest_at, so no banner and the line names the retest date.
+    const rolled = { ...open, next_check_at: open.next_retest_at }
+    const day15 = new Date('2026-11-16T15:00:00.000Z')
+    expect(isQuickCheckDue(rolled, day15)).toBe(false)
+    expect(nextCheckLine(rolled, day15)).toBe('Your next check: Sunday, December 13')
+    // Before day 7 nothing shows either.
+    expect(isQuickCheckDue(open, new Date('2026-11-07T15:00:00.000Z'))).toBe(false)
+  })
+  it('words: Stacy exact, no dashes', () => {
+    expect(Q.note).toBe('A quick check is a snapshot, not a full retest. Your plan stays the same until your 6-week retest.')
+    expect(Q.introBody('Hip')).toBe("We'll re-measure Hip. Then you'll see your day 1 result next to today's.")
+    expect(JSON.stringify(Q)).not.toMatch(/[\u2013\u2014]/)
+  })
+})
