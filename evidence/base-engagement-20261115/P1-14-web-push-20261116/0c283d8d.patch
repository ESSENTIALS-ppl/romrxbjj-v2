new file mode 100644
index 0000000..066ff21
--- /dev/null
+++ b/supabase/functions/send-push-notification/handler.ts
@@ -0,0 +1,118 @@
+// P1-14 send-push-notification. BUILD ONLY, not deployed.
+// Replaces the 2026-10-01 410 stub. Fail-closed x-cron-secret gate (same pattern as
+// send-conversion-drip / cron_call_edge). Sends only when WEB_PUSH_SEND is exactly "on".
+// No mailbox addresses, no VAPID values, and no subscription endpoints are logged or returned.
+// Lock-screen strings are placeholders and need Jim / Stacy wording before WEB_PUSH_SEND is flipped.
+
+export const PUSH_COPY = {
+  protocol: { title: "ROMRx", body: "Your protocol session is due." },
+  retest: { title: "ROMRx", body: "Your 6-week retest is due." },
+  digest: { title: "ROMRx", body: "Your weekly progress is ready." },
+  test: { title: "ROMRx", body: "This is a test notification." },
+} as const;
+
+export type Kind = keyof typeof PUSH_COPY;
+
+export interface PushSub {
+  endpoint: string;
+  p256dh: string;
+  auth: string;
+}
+
+export interface Candidate {
+  userId: string;
+  subscriptionId: string | null;
+  kind: Kind;
+  dedupeKey: string;
+  localDate: string; // YYYY-MM-DD
+  sub: PushSub;
+}
+
+export interface Deps {
+  cronCallerOk: (req: Request) => Promise<boolean>;
+  webPushSend: string | undefined;
+  vapidPublicKey: string | undefined;
+  vapidPrivateKey: string | undefined;
+  vapidSubject: string | undefined;
+  now: () => Date;
+  listDue: (kinds: Kind[], now: Date) => Promise<Candidate[]>;
+  claim: (userId: string, dedupeKey: string) => Promise<boolean>;
+  send: (sub: PushSub, payload: string) => Promise<{ ok: boolean; gone?: boolean }>;
+  markSuccess: (subscriptionId: string | null) => Promise<void>;
+  markFailure: (subscriptionId: string | null, gone: boolean) => Promise<void>;
+}
+
+export function sendEnabled(value: string | undefined): boolean {
+  return value === "on";
+}
+
+export function vapidSubjectOk(subject: string | undefined): boolean {
+  if (!subject) return false;
+  return subject.startsWith("mailto:") || subject.startsWith("https:");
+}
+
+export function vapidReady(d: Pick<Deps, "vapidPublicKey" | "vapidPrivateKey" | "vapidSubject">): boolean {
+  return !!(d.vapidPublicKey && d.vapidPrivateKey && vapidSubjectOk(d.vapidSubject));
+}
+
+export function dedupeKey(kind: Kind, localDate: string): string {
+  return `${kind}:${localDate}`;
+}
+
+export async function handle(req: Request, d: Deps): Promise<Response> {
+  if (req.method === "OPTIONS") return new Response(null, { status: 204 });
+  if (req.method !== "POST") return new Response(JSON.stringify({ error: "method_not_allowed" }), { status: 405, headers: { "Content-Type": "application/json" } });
+  if (!(await d.cronCallerOk(req))) return new Response(JSON.stringify({ error: "forbidden" }), { status: 403, headers: { "Content-Type": "application/json" } });
+
+  let kinds: Kind[] = ["protocol", "retest"];
+  try {
+    const body = await req.json().catch(() => ({})) as { kinds?: unknown };
+    if (Array.isArray(body.kinds) && body.kinds.length) {
+      const allowed = body.kinds.filter((k): k is Kind => k === "protocol" || k === "retest" || k === "digest" || k === "test");
+      if (allowed.length) kinds = allowed;
+    }
+  } catch {
+    // default kinds
+  }
+
+  const live = sendEnabled(d.webPushSend);
+  if (live && !vapidReady(d)) {
+    return new Response(JSON.stringify({ error: "vapid_not_configured", dry_run: false, sent: 0 }), { status: 503, headers: { "Content-Type": "application/json" } });
+  }
+
+  const due = await d.listDue(kinds, d.now());
+  let claimed = 0;
+  let sent = 0;
+  let failed = 0;
+  let skipped = 0;
+  for (const c of due) {
+    const key = c.dedupeKey || dedupeKey(c.kind, c.localDate);
+    if (live) {
+      const okClaim = await d.claim(c.userId, key);
+      if (!okClaim) { skipped += 1; continue; }
+      claimed += 1;
+      const payload = JSON.stringify(PUSH_COPY[c.kind]);
+      const result = await d.send(c.sub, payload);
+      if (result.ok) {
+        sent += 1;
+        await d.markSuccess(c.subscriptionId);
+      } else {
+        failed += 1;
+        await d.markFailure(c.subscriptionId, !!result.gone);
+      }
+    } else {
+      skipped += 1; // counted as dry-run candidates, not claimed
+    }
+  }
+
+  // Response counts only. No user ids, emails, endpoints, or keys.
+  return new Response(JSON.stringify({
+    ok: true,
+    dry_run: !live,
+    due: due.length,
+    claimed: live ? claimed : 0,
+    sent: live ? sent : 0,
+    failed: live ? failed : 0,
+    skipped,
+  }), { status: 200, headers: { "Content-Type": "application/json" } });
+}
diff --git a/supabase/functions/send-push-notification/index.ts b/supabase/functions/send-push-notification/index.ts
index 87f8ee3..a43ce8c 100644
--- a/supabase/functions/send-push-notification/index.ts
+++ b/supabase/functions/send-push-notification/index.ts
@@ -1,9 +1,181 @@
-// send-push-notification: RETIRED 2026-10-01 (security audit). The previous version accepted unauthenticated
-// calls (key check was skipped when the header was absent) and could email/push all users.
-// Not scheduled by pg_cron and not called by any client. Returns 410. Re-introduce only with
-// a fail-closed x-cron-secret gate (see send-s1-2-followup-email cronCallerOk).
-const CORS = { "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type", "Access-Control-Allow-Methods": "POST, OPTIONS" };
-Deno.serve((req: Request) => {
-  if (req.method === "OPTIONS") return new Response(null, { headers: CORS });
-  return new Response(JSON.stringify({ error: "gone" }), { status: 410, headers: { ...CORS, "Content-Type": "application/json" } });
-});
+// send-push-notification (P1-14). Re-introduced after the 2026-10-01 410 stub.
+// BRANCH ONLY, not deployed. verify_jwt must be false (pg_cron, no user JWT).
+// Fail-closed x-cron-secret via public.verify_webhook_secret (cron_webhook_secret), same as other cron senders.
+// Sends only when WEB_PUSH_SEND is exactly "on". Never logs VAPID values, endpoints, or emails.
+import "jsr:@supabase/functions-js/edge-runtime.d.ts";
+import { createClient } from "jsr:@supabase/supabase-js@2";
+import { handle, type Candidate, type Deps, type Kind, type PushSub, dedupeKey, vapidSubjectOk } from "./handler.ts";
+
+const SUPABASE_URL = Deno.env.get("SUPABASE_URL") ?? "";
+const SERVICE = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY") ?? "";
+
+async function cronCallerOk(req: Request): Promise<boolean> {
+  const got = (req.headers.get("x-cron-secret") ?? "").trim();
+  if (got.length < 32) return false;
+  if (!SUPABASE_URL || !SERVICE) return false;
+  try {
+    const r = await fetch(`${SUPABASE_URL}/rest/v1/rpc/verify_webhook_secret`, {
+      method: "POST",
+      headers: { apikey: SERVICE, Authorization: `Bearer ${SERVICE}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ p_name: "cron_webhook_secret", p_candidate: got }),
+    });
+    return r.ok && (await r.json()) === true;
+  } catch {
+    return false;
+  }
+}
+
+function admin() {
+  return createClient(SUPABASE_URL, SERVICE, { auth: { persistSession: false } });
+}
+
+function localDateAndHour(now: Date, tz: string | null): { date: string; hour: number } {
+  const zone = tz && tz.length <= 64 ? tz : "America/New_York";
+  let date = "";
+  let hour = 0;
+  try {
+    const parts = new Intl.DateTimeFormat("en-US", { timeZone: zone, year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", hourCycle: "h23" }).formatToParts(now);
+    const g = (t: string) => parts.find((p) => p.type === t)?.value ?? "";
+    date = `${g("year")}-${g("month")}-${g("day")}`;
+    hour = parseInt(g("hour") || "0", 10);
+  } catch {
+    const parts = new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", hourCycle: "h23" }).formatToParts(now);
+    const g = (t: string) => parts.find((p) => p.type === t)?.value ?? "";
+    date = `${g("year")}-${g("month")}-${g("day")}`;
+    hour = parseInt(g("hour") || "0", 10);
+  }
+  return { date, hour };
+}
+
+function reminderHour(t: string | null | undefined): number | null {
+  if (!t) return 9;
+  const m = /^\s*(\d{1,2})(?::(\d{2}))?/.exec(t);
+  if (!m) return 9;
+  const h = parseInt(m[1], 10);
+  return h >= 0 && h <= 23 ? h : 9;
+}
+
+function subFromJson(raw: unknown): PushSub | null {
+  if (!raw || typeof raw !== "object") return null;
+  const o = raw as { endpoint?: unknown; keys?: { p256dh?: unknown; auth?: unknown } };
+  if (typeof o.endpoint !== "string" || !o.endpoint.startsWith("https://")) return null;
+  const p256dh = o.keys && typeof o.keys.p256dh === "string" ? o.keys.p256dh : "";
+  const auth = o.keys && typeof o.keys.auth === "string" ? o.keys.auth : "";
+  if (p256dh.length < 20 || auth.length < 8) return null;
+  return { endpoint: o.endpoint, p256dh, auth };
